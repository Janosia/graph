{
  "name": "tool-dependency-graph-generator",
  "language": "typescript",
  "entrypoint": "src/generate.ts",
  "build": "npm install",
  "run": "node --import tsx src/generate.ts {catalog}",
  "run_example": "node --import tsx src/generate.ts demo_catalog.json",
  "output": "dependency_graph.json",
  "notes": "The catalog path must be the LAST CLI argument"
}
